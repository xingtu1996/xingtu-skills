{
  "default": {
    "name": "<PERSONA_NAME>",
    "email": "<PERSONA_EMAIL>"
  },
  "rules": [
    {
      "match": [
        "<PREV_PROJECT_PREFIX>"
      ],
      "name": "<PREV_PERSONA_NAME>",
      "email": "<PREV_EMAIL>",
      "note": "示例：某前司项目保留前司邮箱身份"
    },
    {
      "match": [
        "<OSS_PERSONAL_PREFIX>"
      ],
      "name": "<BRAND_NAME>",
      "email": "<BRAND_NOREPLY_EMAIL>",
      "skip": true,
      "note": "示例：个人品牌仓统一用品牌身份"
    }
  ]
}
